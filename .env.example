# Copiar a .env y ajustar. El archivo .env NUNCA se versiona (ver .gitignore).

# Modo: "mitigado" (por defecto, seguro) o "baseline" (sin protecciones, solo demo)
GATEWAY_MODO=mitigado

# Proveedor de inferencia local
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=llama3.2:3b
TIMEOUT_PROVEEDOR=120

# Límites
MAX_CARACTERES_PROMPT=4000
MAX_TOKENS_TECHO=512
LIMITE_PETICIONES=10/minute

# Clientes autorizados: "clave:nombre,clave:nombre"
# En producción estas claves se generan e inyectan por el entorno, nunca aquí.
GATEWAY_API_KEYS=

# Ruta del registro de auditoría
GATEWAY_LOG=logs/gateway.jsonl
